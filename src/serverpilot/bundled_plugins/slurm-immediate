def parse_idx(spec: str) -> set[int]:
    used: set[int] = set()
    spec = spec.strip()
    if not spec:
        return used
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            start_s, end_s = part.split("-", 1)
            used.update(range(int(start_s), int(end_s) + 1))
        else:
            used.add(int(part))
    return used


def is_unschedulable(state: str) -> bool:
    tokens = state.lower().replace("*", " ").replace("+", " ").split()
    if set(tokens) & UNSCHEDULABLE_TOKENS:
        return True
    return any(
        token.startswith("drain") or token.startswith("down") or token.startswith("fail")
        for token in tokens
    )


def parse_gres_used_indexes(text: str, total: int) -> set[int]:
    text = text.strip()
    if not text or text in {"(null)", "N/A", "n/a"}:
        return set()
    idx_at = text.find("IDX:")
    if idx_at >= 0:
        inner = text[idx_at + 4 :]
        if inner.endswith(")"):
            inner = inner[:-1]
        return {index for index in parse_idx(inner) if 0 <= index < total}
    match = re.search(r"gpu:[^:\s]+:(\d+)", text)
    count = int(match.group(1)) if match is not None else 0
    if count <= 0:
        return set()
    if count >= total:
        return set(range(total))
    return set(range(count))


def job_name_from_task_ref(task_ref: str) -> str:
    cleaned = re.sub(r"[^A-Za-z0-9._-]", "-", task_ref).strip("-.")[:32]
    if not cleaned or not re.match(r"[A-Za-z0-9]", cleaned):
        cleaned = "task"
    name = f"sp-{cleaned}"
    return name[:40]


def emit(payload: dict) -> int:
    json.dump(payload, sys.stdout, ensure_ascii=False, separators=(",", ":"))
    sys.stdout.write("\n")
    return 0


def fail(message: str, code: int = 1) -> int:
    sys.stderr.write(message.rstrip() + "\n")
    return code


def config_path() -> Path:
    return Path(sys.argv[0]).resolve().parent / CONFIG_NAME


def load_config() -> dict:
    path = config_path()
    if not path.is_file():
        raise RuntimeError(
            "slurm-immediate is unconfigured. Create "
            f"{path} with ssh_host, partition, gpu_name, vram_mib, "
            "gpus_per_node, cpus_per_gpu, and mem_gib_per_gpu. "
            "Copy this plugin to the user plugin directory if you should "
            "not write next to the bundled copy."
        )
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"slurm-immediate.json is invalid: {exc}") from exc
    if not isinstance(raw, dict):
        raise RuntimeError("slurm-immediate.json must be a JSON object")
    config: dict = {}
    for key in REQUIRED_STR:
        value = raw.get(key)
        if not isinstance(value, str) or not value.strip():
            raise RuntimeError(f"slurm-immediate.json {key} must be a non-empty string")
        config[key] = value.strip()
    for key in REQUIRED_INT:
        value = raw.get(key)
        if type(value) is not int or isinstance(value, bool) or value < 1:
            raise RuntimeError(f"slurm-immediate.json {key} must be a positive integer")
        config[key] = value
    for key in ("qos", "account", "control_path", "workspace_path"):
        value = raw.get(key)
        if value is None or value == "":
            config[key] = ""
            continue
        if not isinstance(value, str) or not value.strip():
            raise RuntimeError(f"slurm-immediate.json {key} must be a string")
        config[key] = value.strip()
    if config["workspace_path"] and not config["workspace_path"].startswith("/"):
        raise RuntimeError("slurm-immediate.json workspace_path must be an absolute path")
    ssh_port = raw.get("ssh_port")
    if ssh_port is None:
        config["ssh_port"] = 22
        config["pass_ssh_port"] = False
    elif type(ssh_port) is not int or isinstance(ssh_port, bool) or not 1 <= ssh_port <= 65535:
        raise RuntimeError("slurm-immediate.json ssh_port must be an integer 1-65535")
    else:
        config["ssh_port"] = ssh_port
        config["pass_ssh_port"] = True
    return config


def ssh_argv(config: dict, *rest: str) -> list[str]:
    argv = ["ssh"]
    control_path = config.get("control_path") or ""
    if control_path:
        argv.extend(["-o", f"ControlPath={control_path}"])
    if config.get("pass_ssh_port") and rest[:1] != ("-O",):
        argv.extend(["-p", str(config["ssh_port"])])
    argv.extend(rest)
    return argv


def master_alive(config: dict) -> tuple[bool, str]:
    probe = subprocess.run(
        ssh_argv(config, "-O", "check", config["ssh_host"]),
        capture_output=True,
        text=True,
        check=False,
        stdin=subprocess.DEVNULL,
    )
    detail = (probe.stderr or probe.stdout).strip().splitlines()
    return probe.returncode == 0, detail[-1] if detail else ""


def require_master(config: dict) -> str | None:
    alive, detail = master_alive(config)
    if alive:
        return None
    host = config["ssh_host"]
    return (
        f"no live ControlMaster for {host}"
        + (f" ({detail})" if detail else "")
        + f". Open one first with: ssh -fN {host}. "
        "This plugin never authenticates."
    )


def remote_script(config: dict) -> str:
    injected = {
        "ssh_host": config["ssh_host"],
        "ssh_port": config["ssh_port"],
        "partition": config["partition"],
        "qos": config["qos"],
        "account": config["account"],
        "gpu_name": config["gpu_name"],
        "vram_mib": config["vram_mib"],
        "gpus_per_node": config["gpus_per_node"],
        "cpus_per_gpu": config["cpus_per_gpu"],
        "mem_gib_per_gpu": config["mem_gib_per_gpu"],
        "workspace_path": config["workspace_path"],
    }
    return "CONFIG = " + json.dumps(injected, ensure_ascii=True) + "\n" + REMOTE_HELPER


def ssh_python(config: dict, verb: str, *args: str, timeout: int = 40) -> str:
    completed = subprocess.run(
        ssh_argv(
            config,
            "-o",
            "ControlMaster=no",
            "-o",
            "BatchMode=yes",
            config["ssh_host"],
            "python3",
            "-",
            verb,
            *args,
        ),
        input=remote_script(config),
        capture_output=True,
        text=True,
        check=False,
        timeout=timeout,
    )
    if completed.returncode != 0:
        detail = (completed.stderr or completed.stdout).strip().replace("\n", " ")[:500]
        raise RemoteFailure(
            detail or f"ssh exited {completed.returncode}",
            no_capacity=completed.returncode == NO_CAPACITY_EXIT_CODE,
        )
    return completed.stdout


def cmd_info() -> int:
    return emit(
        {
            "plugin_id": "slurm-immediate",
            "display_name": "Slurm 立刻申请",
            "schema_version": SCHEMA_VERSION,
            "capabilities": ["observe", "apply", "release"],
            "description": (
                "只观测本用户自己的 Slurm GPU 作业；用 srun --immediate 立刻申请，"
                "不能马上启动则失败、不排队。集群参数来自插件旁的 slurm-immediate.json；"
                "未配置则失败。配置了 SSH 目标时，master 不在则失败，绝不认证。"
            ),
        }
    )


def cmd_observe(config: dict) -> int:
    missing = require_master(config)
    if missing:
        return fail(missing)
    try:
        payload = json.loads(ssh_python(config, "observe"))
    except Exception as exc:
        return fail(f"slurm-immediate observe failed: {exc}")
    gpus = payload.get("gpus") or []
    has_gpus = bool(gpus)
    snapshot = {
        "schema_version": SCHEMA_VERSION,
        "identity": {
            "hostname": payload["hostname"],
            "boot_id": payload["boot_id"],
        },
        "host": {
            "cpu_count": payload["cpu_count"],
            "load_1m": payload["load_1m"],
            "cpu_total_ticks": payload["cpu_total_ticks"],
            "cpu_idle_ticks": payload["cpu_idle_ticks"],
            "memory_total_mib": payload["memory_total_mib"],
            "memory_available_mib": payload["memory_available_mib"],
        },
        "gpu_probe_available": has_gpus,
        "gpu_probe_status": "gpu" if has_gpus else "cpu_only",
        "gpus": gpus,
        "processes": payload.get("processes") or [],
    }
    scheduler = payload.get("scheduler")
    if isinstance(scheduler, dict):
        snapshot["scheduler"] = scheduler
    return emit(snapshot)


def cmd_apply(config: dict, argv: list[str]) -> int:
    missing = require_master(config)
    if missing:
        return fail(missing)
    gpu_count = None
    task_ref = None
    rest = argv[1:]
    while rest:
        flag, rest = rest[0], rest[1:]
        if flag == "--gpu-count" and rest:
            gpu_count, rest = rest[0], rest[1:]
            continue
        if flag == "--task-ref" and rest:
            task_ref, rest = rest[0], rest[1:]
            continue
        return fail("slurm-immediate apply requires --gpu-count N --task-ref REF")
    try:
        count = int(gpu_count) if gpu_count is not None else 0
    except (TypeError, ValueError):
        return fail("slurm-immediate apply gpu_count must be a positive integer")
    if type(count) is not int or isinstance(count, bool) or count < 1:
        return fail("slurm-immediate apply gpu_count must be a positive integer")
    if not isinstance(task_ref, str) or not task_ref.strip():
        return fail("slurm-immediate apply requires a non-empty --task-ref")
    # task_ref is a human task name and may be any script. job_name_from_task_ref
    # is what bounds it into a Slurm job name; JOB_NAME_PATTERN below is the
    # check that actually guards the argv.
    job_name = job_name_from_task_ref(task_ref)
    if not JOB_NAME_PATTERN.fullmatch(job_name):
        return fail("slurm-immediate apply job name is invalid")
    try:
        payload = json.loads(
            ssh_python(config, "apply", str(count), job_name, timeout=SSH_APPLY_TIMEOUT_SECONDS)
        )
    except Exception as exc:
        code = NO_CAPACITY_EXIT_CODE if getattr(exc, "no_capacity", False) else 1
        return fail(f"slurm-immediate apply failed: {exc}", code)
    return emit(
        {
            "allocation_ref": payload["allocation_ref"],
            "ssh": payload["ssh"],
            "workspace_path": payload["workspace_path"],
            "cuda_visible_devices": payload["cuda_visible_devices"],
            "gpus": payload.get("gpus", []),
        }
    )


def cmd_release(config: dict, argv: list[str]) -> int:
    missing = require_master(config)
    if missing:
        return fail(missing)
    rest = argv[1:]
    allocation_ref = None
    if rest[:1] == ["--allocation-ref"] and len(rest) >= 2:
        allocation_ref = rest[1]
    if not isinstance(allocation_ref, str) or not ALLOCATION_REF_PATTERN.fullmatch(allocation_ref):
        return fail("slurm-immediate release allocation-ref is invalid")
    if not allocation_ref.isdigit():
        return fail("slurm-immediate release allocation-ref must be a Slurm job id")
    try:
        payload = json.loads(ssh_python(config, "release", allocation_ref))
    except Exception as exc:
        return fail(f"slurm-immediate release failed: {exc}")
    if payload.get("state") != "released":
        return fail("slurm-immediate release state must be released")
    return emit({"state": "released"})


def main(argv: list[str]) -> int:
    if argv == ["info"]:
        return cmd_info()
    try:
        config = load_config()
    except RuntimeError as exc:
        return fail(str(exc))
    if argv == ["observe"]:
        return cmd_observe(config)
    if argv[:1] == ["apply"]:
        return cmd_apply(config, argv)
    if argv[:1] == ["release"]:
        return cmd_release(config, argv)
    return fail("slurm-immediate supports info, observe, apply, and release")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
