def parse_idx(spec):
    used = set()
    spec = spec.strip()
    if not spec:
        return used
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            start_s, end_s = part.split("-", 1)
            used.update(range(int(start_s), int(end_s) + 1))
        else:
            used.add(int(part))
    return used


def is_unschedulable(state):
    tokens = state.lower().replace("*", " ").replace("+", " ").split()
    if set(tokens) & UNSCHEDULABLE_TOKENS:
        return True
    return any(
        token.startswith("drain") or token.startswith("down") or token.startswith("fail")
        for token in tokens
    )


def parse_gres_total(text):
    match = re.search(r"gpu:[^:\s]+:(\d+)", text)
    if match is None:
        return GPUS_PER_NODE
    return int(match.group(1))


def parse_gres_used_indexes(text, total):
    text = text.strip()
    if not text or text in {"(null)", "N/A", "n/a"}:
        return set()
    idx_at = text.find("IDX:")
    if idx_at >= 0:
        inner = text[idx_at + 4:]
        if inner.endswith(")"):
            inner = inner[:-1]
        if inner.upper() != "N/A":
            return {index for index in parse_idx(inner) if 0 <= index < total}
    # Slurm may withhold indexes as IDX:N/A while still reporting the count.
    # Only cardinality is used by the capacity calculation.
    match = re.search(r"gpu:(?:[^:\s]+:)?(\d+)(?:\(|$)", text)
    if match is None:
        raise ValueError(f"unrecognized GPU allocation count: {text}")
    count = int(match.group(1))
    if count <= 0:
        return set()
    if count >= total:
        return set(range(total))
    return set(range(count))


def host_telemetry():
    cpu_count = os.cpu_count() or 1
    load_1m = 0.0
    try:
        with open("/proc/loadavg", encoding="utf-8") as handle:
            load_1m = float(handle.read().split()[0])
    except OSError:
        pass
    cpu_total_ticks = 0
    cpu_idle_ticks = 0
    try:
        with open("/proc/stat", encoding="utf-8") as handle:
            parts = handle.readline().split()
        if parts and parts[0] == "cpu":
            values = [int(item) for item in parts[1:]]
            cpu_total_ticks = sum(values)
            cpu_idle_ticks = values[3] + values[4] if len(values) > 4 else values[3]
    except OSError:
        pass
    memory_total_mib = 1
    memory_available_mib = 0
    try:
        mem = {}
        with open("/proc/meminfo", encoding="utf-8") as handle:
            for line in handle:
                key, _, value = line.partition(":")
                mem[key] = value.strip().split()[0]
        memory_total_mib = max(1, int(mem.get("MemTotal", "1024")) // 1024)
        memory_available_mib = int(mem.get("MemAvailable", "0")) // 1024
    except OSError:
        pass
    hostname = os.uname().nodename
    boot_id = "unknown"
    try:
        boot_id = open("/proc/sys/kernel/random/boot_id", encoding="utf-8").read().strip()
    except OSError:
        pass
    return {
        "hostname": hostname,
        "boot_id": boot_id,
        "cpu_count": cpu_count,
        "load_1m": load_1m,
        "cpu_total_ticks": cpu_total_ticks,
        "cpu_idle_ticks": cpu_idle_ticks,
        "memory_total_mib": memory_total_mib,
        "memory_available_mib": memory_available_mib,
    }


def cluster_gpu_capacity():
    raw = subprocess.check_output(
        [
            "sinfo", "-N", "-h", "-p", PARTITION, "-O",
            "NodeList:32,StateCompact:20,Gres:40,GresUsed:80",
        ],
        text=True,
    )
    nodes = []
    for line in raw.splitlines():
        if not line.strip():
            continue
        if len(line) < 92:
            raise ValueError("incomplete Slurm node row")
        name = line[0:32].strip()
        state = line[32:52].strip()
        total = parse_gres_total(line[52:92].strip())
        allocated = len(parse_gres_used_indexes(line[92:].strip(), total))
        nodes.append({
            "name": name,
            "state": state,
            "total_gpus": total,
            "allocated_gpus": allocated,
            "schedulable": not is_unschedulable(state),
        })
    free = [node["total_gpus"] - node["allocated_gpus"]
            for node in nodes if node["schedulable"]]
    return {
        "free_gpu_count": sum(free),
        "largest_free_block": max(free, default=0),
        "nodes": nodes,
    }

def timestamp():
    return datetime.now(timezone.utc).isoformat()


def atomic_json(path, payload):
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(payload, separators=(",", ":")))
    temporary.replace(path)


def read_json(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def entry(job_id):
    return {"kind": "allocation", "host": CONFIG["ssh_host"], "port": CONFIG["ssh_port"],
            "user": os.environ.get("USER") or Path.home().name,
            "workspace_path": CONFIG["workspace_path"] or str(Path.home()),
            "argv": ["srun", "--jobid=" + job_id, "--overlap", "--pty", "bash"],
            "exec_prefix": ["srun", "--jobid=" + job_id, "--overlap"],
            "instructions": "先连接登录入口，再用上述命令进入已有分配；在该环境中使用 CUDA 设备编号。",
            "verified": CONFIG["entry_verified"]}


def job_details(job_id):
    result = subprocess.run(["scontrol", "show", "job", job_id, "-dd", "-o"], capture_output=True, text=True, timeout=10)
    if result.returncode == 0:
        values = dict(re.findall(r"(?:^|\s)([A-Za-z][A-Za-z0-9_]*)=(\S+)", result.stdout))
        values["NodePlacements"] = re.findall(r"(?:^|\s)Nodes=(\S+)\s+CPU_IDs=\S+\s+Mem=\S+\s+GRES=(\S+)", result.stdout)
        return values
    history = subprocess.run(["sacct", "-n", "-P", "-j", job_id, "--format=JobIDRaw,State,NodeList,End"],
                             capture_output=True, text=True, timeout=10)
    if history.returncode == 0:
        for line in history.stdout.splitlines():
            parts = line.split("|")
            if len(parts) >= 4 and parts[0] == job_id:
                return {"JobState": parts[1].split()[0], "NodeList": parts[2], "EndTime": parts[3]}
    return {}


def utc_time(value):
    if not value or value in {"Unknown", "N/A", "None", "UNLIMITED"}:
        return None
    try:
        return datetime.fromisoformat(value).astimezone(timezone.utc).isoformat()
    except ValueError:
        return None


def allocation_fact(job_id, request=None, sample=None):
    details = job_details(job_id)
    state = details.get("JobState", "UNKNOWN").split("+")[0]
    mapped = {"RUNNING": "active", "COMPLETING": "active", "SUSPENDED": "active",
              "COMPLETED": "released", "CANCELLED": "released", "TIMEOUT": "expired",
              "FAILED": "failed", "NODE_FAIL": "failed", "OUT_OF_MEMORY": "failed", "PREEMPTED": "failed"}
    locations = []
    placements = details.get("NodePlacements", [])
    for node_list, gres in placements:
        count = sum(int(item) for item in re.findall(r"(?:^|,)gpu(?::[A-Za-z0-9_.-]+)?:(\d+)(?:\(|,|$)", gres))
        names = subprocess.run(["scontrol", "show", "hostnames", node_list], capture_output=True, text=True, timeout=5)
        if names.returncode:
            raise RuntimeError("Slurm job node expansion failed")
        locations.extend({"node": name, "gpu_count": count, "devices": [], "running_process_count": None}
                         for name in names.stdout.split())
    if locations:
        pass
    elif sample:
        locations = [{"node": sample["node"], "gpu_count": sample["gpu_count"],
                      "devices": sample["devices"], "running_process_count": sample["running_process_count"]}]
    elif request and request.get("last_locations"):
        locations = [{**item, "running_process_count": None,
                      "devices": [{**device, "running_process_count": None} for device in item["devices"]]}
                     for item in request["last_locations"]]
    else:
        nodes = details.get("NodeList", "")
        # Unknown card placement stays unknown; aggregate external requests have no fake UUIDs.
        if nodes and nodes not in {"(null)", "None", "N/A"}:
            raw = subprocess.run(["scontrol", "show", "hostnames", nodes], capture_output=True, text=True, timeout=10)
            names = raw.stdout.split() if raw.returncode == 0 else []
            tres = next((details[key] for key in ("AllocTRES", "TRES") if key in details), "")
            gpu = re.search(r"(?:^|,)gres/gpu=(\d+)(?:,|$)", tres)
            if len(names) == 1 and gpu:
                locations = [{"node": names[0], "gpu_count": int(gpu.group(1)), "devices": [], "running_process_count": None}]
    fact = {"name": details.get("JobName"), "owner": details.get("UserId", "").split("(")[0] or None,
            "accounting": None, "allocation_ref": job_id, "request_id": request.get("request_id") if request else None,
            "state": mapped.get(state, "unknown"), "locations": locations,
            "entry": entry(job_id) if request else None,
            "expires_at": utc_time(details.get("EndTime")), "observed_at": timestamp(),
            "workload_observed_at": sample.get("workload_observed_at") if sample else None}
    return fact


def read_accounting(job_ids):
    result = subprocess.run(["sstat", "-a", "-j", ",".join(job_ids), "-P", "-n", "--format=JobID,TRESUsageInTot"],
                            capture_output=True, text=True, timeout=5)
    if result.returncode:
        return {}
    values = {}
    seen = set()
    for line in result.stdout.splitlines():
        parts = line.split("|")
        if len(parts) < 2 or parts[0] in seen:
            continue
        seen.add(parts[0])
        job_id = parts[0].split(".")[0]
        if job_id not in job_ids:
            continue
        fields = dict(item.split("=", 1) for item in parts[1].split(",") if "=" in item)
        row = values.setdefault(job_id, {"cpu_time_seconds": None, "rss_mib": None, "observed_at": timestamp()})
        cpu = re.fullmatch(r"(?:(\d+)-)?(\d+):(\d+):(\d+(?:\.\d+)?)", fields.get("cpu", ""))
        if cpu:
            day, hour, minute, second = cpu.groups()
            row["cpu_time_seconds"] = (row["cpu_time_seconds"] or 0) + int(day or 0) * 86400 + int(hour) * 3600 + int(minute) * 60 + float(second)
        mem = re.fullmatch(r"(\d+(?:\.\d+)?)([KMGT]?)", fields.get("mem", ""))
        if mem:
            row["rss_mib"] = (row["rss_mib"] or 0) + float(mem.group(1)) * {"": 1/1048576, "K": 1/1024, "M": 1, "G": 1024, "T": 1048576}[mem.group(2)]
    return values


def all_allocations():
    requests = {}
    samples = {}
    if ROOT.is_dir():
        for path in ROOT.glob("request-*.json"):
            request = read_json(path)
            if not request:
                continue
            sample = read_json(ROOT / (request["request_id"] + ".json"))
            job_id = sample.get("allocation_ref") if sample else request.get("allocation_ref")
            if job_id:
                requests[job_id] = request
                if sample:
                    samples[job_id] = sample
    result = subprocess.run(["squeue", "-r", "-u", os.environ.get("USER") or Path.home().name,
                             "-h", "-o", "%i"], capture_output=True, text=True, timeout=10)
    if result.returncode:
        raise RuntimeError("Slurm allocation query failed")
    ids = set(requests) | {line.strip() for line in result.stdout.splitlines() if re.fullmatch(r"[0-9]+(?:_[0-9]+)?", line.strip())}
    facts = [allocation_fact(job_id, requests.get(job_id), samples.get(job_id)) for job_id in sorted(ids)]
    running = [fact["allocation_ref"] for fact in facts if fact["state"] == "active"]
    accounting = read_accounting(running) if running else {}
    for fact in facts:
        fact["accounting"] = accounting.get(fact["allocation_ref"])
    return facts


def observe_node(node, timeout_seconds):
    record = {"node_id": node, "observed_at": timestamp(), "output": None, "error_code": None, "message": None}
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", node):
        raise RuntimeError("invalid Slurm node identity")
    try:
        result = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=yes",
            "-o", "ConnectTimeout=5", node, "sh"], input=NODE_PROBE,
            capture_output=True, text=True, timeout=timeout_seconds)
        if result.returncode:
            message = result.stderr.lower()
            code = "host_key_rejected" if "host key" in message or "host identification" in message else "auth_failed" if "permission denied" in message else "connection_failed"
            record.update(error_code=code, message="Compute node SSH probe failed: " + code)
        else:
            record["output"] = result.stdout
    except subprocess.TimeoutExpired:
        record.update(error_code="command_timeout", message="Compute node probe timed out")
    return record


def cmd_observe():
    from concurrent.futures import ThreadPoolExecutor
    capacity = cluster_gpu_capacity()
    allocations = all_allocations()
    nodes = sorted({location["node"] for allocation in allocations if allocation["state"] == "active"
                    for location in allocation["locations"]})
    # One endpoint deadline; queued nodes report an explicit unknown instead of
    # making one slow node discard every healthy observation.
    deadline = time.monotonic() + 20
    def bounded_probe(node):
        if time.monotonic() >= deadline:
            return {"node_id": node, "observed_at": timestamp(), "output": None, "error_code": "command_timeout", "message": "Node probe budget exhausted"}
        return observe_node(node, min(15, max(1, deadline - time.monotonic())))
    with ThreadPoolExecutor(max_workers=4) as pool:
        samples = list(pool.map(bounded_probe, nodes))
    print(json.dumps({"nodes": samples, "allocations": allocations,
                      "scheduler": {**capacity, "observed_at": timestamp(), "gpu_name": GPU_NAME, "vram_mib": VRAM_MIB,
                                    "max_gpus_per_lease": GPUS_PER_NODE, "cpu_cores_per_gpu": CPUS_PER_GPU,
                                    "memory_mib_per_gpu": MEM_GIB_PER_GPU * 1024, "note": "按需申请，不排队"}},
                     separators=(",", ":")))


def cmd_apply():
    count = int(sys.argv[2])
    duration = int(sys.argv[3])
    request_id = sys.argv[4]
    if cluster_gpu_capacity()["largest_free_block"] < count:
        raise SystemExit(NO_CAPACITY_EXIT_CODE)
    ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    request_path = ROOT / ("request-" + request_id + ".json")
    # The exclusive file is a durable reservation of this application identity.
    # An uncertain attempt is queried, never submitted a second time.
    try:
        with request_path.open("x") as handle:
            json.dump({"request_id": request_id, "allocation_ref": None}, handle)
    except FileExistsError:
        fact = next((item for item in all_allocations() if item["request_id"] == request_id), None)
        if fact and fact["state"] == "active":
            print(json.dumps(fact, separators=(",", ":")))
            return
        raise RuntimeError("original allocation outcome is unconfirmed; no resubmission")
    hold = ROOT / ("hold-" + request_id + ".py")
    hold.write_text(HOLD_SCRIPT)
    log = ROOT / ("request-" + request_id + ".log")
    argv = ["srun", "-I" + str(APPLY_IMMEDIATE_SECONDS), "--time=" + str((duration + 59) // 60),
            "-p", PARTITION, "-N1", "--ntasks=1", "--gres=gpu:" + str(count),
            "-c", str(CPUS_PER_GPU * count), "--mem=" + str(MEM_GIB_PER_GPU * count) + "G",
            "--job-name=sp-" + request_id, "--export=ALL,CUDA_DEVICE_ORDER=PCI_BUS_ID"]
    if QOS:
        argv.extend(["--qos", QOS])
    if ACCOUNT:
        argv.extend(["-A", ACCOUNT])
    argv.extend(["python3", str(hold), request_id, str(count)])
    with log.open("w") as output:
        proc = subprocess.Popen(argv, stdout=output, stderr=output, stdin=subprocess.DEVNULL, start_new_session=True)
    deadline = time.monotonic() + APPLY_IMMEDIATE_SECONDS + 5
    while time.monotonic() < deadline:
        sample = read_json(ROOT / (request_id + ".json"))
        if sample:
            job_id = sample["allocation_ref"]
            fact = allocation_fact(job_id, {"request_id": request_id}, sample)
            atomic_json(request_path, {"request_id": request_id, "allocation_ref": job_id,
                                       "last_locations": fact["locations"]})
            if fact["state"] == "active" and fact["expires_at"]:
                print(json.dumps(fact, separators=(",", ":")))
                return
        if proc.poll() is not None:
            raise RuntimeError("Slurm apply exited; original request retained for reconciliation")
        time.sleep(0.25)
    raise RuntimeError("allocation outcome unconfirmed; inspect the original request")


def cmd_release():
    job_id = sys.argv[2]
    # Release is idempotent; command success alone is not completion evidence.
    result = subprocess.run(["scancel", job_id], capture_output=True, text=True, timeout=10)
    if result.returncode and "Invalid job id" not in result.stderr:
        raise RuntimeError("Slurm release command failed")
    fact = allocation_fact(job_id)
    if fact["state"] not in {"released", "expired", "failed"}:
        raise RuntimeError("release requested; provider completion is not yet confirmed")
    print(json.dumps({"state": "released"}, separators=(",", ":")))


verb = sys.argv[1]
if verb == "observe":
    cmd_observe()
elif verb == "apply":
    cmd_apply()
elif verb == "release":
    cmd_release()
else:
    raise SystemExit("unsupported verb")
