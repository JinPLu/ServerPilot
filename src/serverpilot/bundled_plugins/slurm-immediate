#!/usr/bin/env python3
"""Slurm observer and immediate GPU apply. Never authenticates.

Cluster identity comes from slurm-immediate.json next to this executable.
Observe reports only this user's running GPU jobs. Apply uses
``srun --immediate``; if the job is not running within the immediate
window, it fails and does not queue. Release calls ``scancel`` on that
job id. When an SSH target is configured, a live ControlMaster is
required; this plugin does not open a new connection, prompt, or consume
a TOTP code.
"""

from __future__ import annotations

import json
import re
import subprocess
import sys
from pathlib import Path

SCHEMA_VERSION = 2
CONFIG_NAME = "slurm-immediate.json"
APPLY_TIME_LIMIT = "01:00:00"
APPLY_IMMEDIATE_SECONDS = 25
SSH_APPLY_TIMEOUT_SECONDS = 50
NO_CAPACITY_EXIT_CODE = 3
JOB_NAME_PATTERN = re.compile(r"^[A-Za-z0-9._-]{1,40}$")


class RemoteFailure(RuntimeError):
    """A remote verb failed. no_capacity separates "nothing free now" from a fault."""

    def __init__(self, message: str, *, no_capacity: bool = False) -> None:
        super().__init__(message)
        self.no_capacity = no_capacity
ALLOCATION_REF_PATTERN = re.compile(r"^[A-Za-z0-9._:-]{1,128}$")
REQUIRED_STR = ("ssh_host", "partition", "gpu_name")
REQUIRED_INT = ("vram_mib", "gpus_per_node", "cpus_per_gpu", "mem_gib_per_gpu")
UNSCHEDULABLE_TOKENS = frozenset(
    {
        "drain",
        "drng",
        "drained",
        "down",
        "fail",
        "failing",
        "unknown",
        "unk",
        "maint",
        "maintenance",
        "n/a",
        "not_responding",
    }
)

