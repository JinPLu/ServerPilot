ALLOCATION_REF_PATTERN = re.compile(r"^[0-9]+(?:_[0-9]+)?$")
UNSCHEDULABLE_TOKENS = frozenset({"drain", "drng", "drained", "down", "fail", "failing", "unknown", "unk", "maint", "maintenance", "n/a", "not_responding"})


class RemoteFailure(RuntimeError):
    def __init__(self, message: str, *, no_capacity: bool = False) -> None:
        super().__init__(message)
        self.no_capacity = no_capacity


def emit(payload: dict) -> int:
    print(json.dumps(payload, ensure_ascii=False, separators=(",", ":")))
    return 0


def fail(message: str, code: int = 1) -> int:
    print(message, file=sys.stderr)
    return code


def config_path() -> Path:
    return Path(sys.argv[0]).resolve().with_name(Path(sys.argv[0]).name + ".json")


def load_config() -> dict:
    path = config_path()
    raw = json.loads(path.read_text())
    if not isinstance(raw, dict):
        raise ValueError("provider configuration must be an object")
    required = {"ssh_host", "partition", "gpu_name", "vram_mib", "gpus_per_node", "cpus_per_gpu", "mem_gib_per_gpu", "max_lease_seconds"}
    if not required.issubset(raw):
        raise ValueError("provider is unconfigured; missing " + ", ".join(sorted(required - set(raw))))
    for key in ("ssh_host", "partition", "gpu_name"):
        if not isinstance(raw[key], str) or not raw[key] or any(c in raw[key] for c in "\x00\n\r"):
            raise ValueError("invalid provider configuration: " + key)
    for key in ("vram_mib", "gpus_per_node", "cpus_per_gpu", "mem_gib_per_gpu", "max_lease_seconds"):
        if type(raw[key]) is not int or raw[key] <= 0:
            raise ValueError("invalid provider configuration: " + key)
    if raw["max_lease_seconds"] > 2592000:
        raise ValueError("provider maximum duration exceeds the public 30-day bound")
    for key in ("qos", "account", "workspace_path", "control_path", "credential_path"):
        raw.setdefault(key, "")
        if not isinstance(raw[key], str) or any(c in raw[key] for c in "\x00\n\r"):
            raise ValueError("invalid provider configuration: " + key)
    raw.setdefault("ssh_port", 22)
    if type(raw["ssh_port"]) is not int or not 1 <= raw["ssh_port"] <= 65535:
        raise ValueError("invalid SSH port")
    raw.setdefault("entry_verified", False)
    if type(raw["entry_verified"]) is not bool:
        raise ValueError("entry_verified must be a boolean")
    return raw


def ssh_argv(config: dict, *rest: str) -> list[str]:
    argv = ["ssh", "-p", str(config["ssh_port"])]
    if config["control_path"]:
        argv.extend(["-o", "ControlPath=" + config["control_path"]])
    return [*argv, *rest]


def master_alive(config: dict) -> tuple[bool, str]:
    result = subprocess.run(ssh_argv(config, "-O", "check", config["ssh_host"]),
                            capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=5)
    return result.returncode == 0, "existing SSH session" if result.returncode == 0 else "SSH session missing"


def connection_fact(state: str, error_code: str | None, message: str) -> dict:
    return {"state": state, "error_code": error_code, "message": message}


def totp(secret: str) -> str:
    remaining = 30 - time.time() % 30
    if remaining < 12:
        time.sleep(remaining + 0.1)
    key = base64.b32decode(secret.upper() + "=" * (-len(secret) % 8))
    digest = hmac.new(key, struct.pack(">Q", int(time.time()) // 30), hashlib.sha1).digest()
    offset = digest[-1] & 15
    return f"{(struct.unpack('>I', digest[offset:offset+4])[0] & 0x7fffffff) % 1000000:06d}"


def network_ready(config: dict) -> bool:
    effective = subprocess.run(ssh_argv(config, "-G", config["ssh_host"]), capture_output=True, text=True, timeout=5)
    if effective.returncode:
        raise RuntimeError("SSH configuration lookup failed")
    fields = dict(line.split(" ", 1) for line in effective.stdout.splitlines() if " " in line)
    try:
        channel = socket.create_connection((fields["hostname"], int(fields["port"])), timeout=3)
    except OSError:
        return False
    with channel:
        channel.settimeout(3)
        try:
            banner = channel.recv(255)
        except OSError as exc:
            raise RuntimeError("SSH greeting was not confirmed; authentication stopped") from exc
        if not banner.startswith(b"SSH-"):
            raise RuntimeError("SSH greeting was not confirmed; authentication stopped")
    return True


def authenticate(config: dict) -> dict:
    if master_alive(config)[0]:
        return connection_fact("connected", None, "登录连接可用。")
    if not network_ready(config):
        return connection_fact("network_unavailable", "network_unreachable", "SSH 网络不可达，等待网络恢复；未尝试认证。")
    argv = ssh_argv(config, "-M", "-N", "-f", "-o", "ConnectTimeout=10", "-o", "ServerAliveInterval=30",
                    "-o", "ServerAliveCountMax=3", "-o", "ControlPersist=12h",
                    "-o", "StrictHostKeyChecking=yes")
    if not config["credential_path"]:
        result = subprocess.run([*argv, "-o", "BatchMode=yes", config["ssh_host"]],
                                capture_output=True, stdin=subprocess.DEVNULL, timeout=20)
        if result.returncode == 0 and master_alive(config)[0]:
            return connection_fact("connected", None, "登录连接已建立。")
        return connection_fact("action_required", "connection_failed", "SSH 认证未完成，自动恢复已停止；请检查账号、密钥和服务器指纹。")
    # Credentials are read only here, never by info/observe/apply/release.
    path = Path(config["credential_path"]).expanduser()
    if path.stat().st_mode & 0o077:
        return connection_fact("action_required", "auth_failed", "凭据文件权限必须为 600。")
    credentials = {key.strip(): value.strip() for line in path.read_text().splitlines() if "=" in line
                   for key, value in [line.split("=", 1)]}
    password, secret = credentials.get("PASSWORD"), credentials.get("SECRET")
    if not password or not secret:
        return connection_fact("action_required", "auth_failed", "凭据文件缺少密码或动态码种子。")
    import pty
    import select
    pid, fd = pty.fork()
    if pid == 0:
        os.execvp("ssh", [*argv, config["ssh_host"]])
        os._exit(127)
    buffer = b""
    sent_password = sent_code = False
    rejected = False
    deadline = time.monotonic() + 40
    try:
        while time.monotonic() < deadline:
            if not select.select([fd], [], [], 0.5)[0]:
                continue
            try:
                chunk = os.read(fd, 4096)
            except OSError:
                break
            if not chunk:
                break
            buffer = (buffer + chunk)[-1024:]
            if b"permission denied" in buffer.lower():
                rejected = True
                break
            if re.search(rb"verification code:\s*$", buffer, re.I):
                if sent_code:
                    rejected = True
                    break
                os.write(fd, totp(secret).encode() + b"\r")
                sent_code = True
                buffer = b""
            elif re.search(rb"password:\s*$", buffer, re.I):
                if sent_password:
                    rejected = True
                    break
                os.write(fd, password.encode() + b"\r")
                sent_password = True
                buffer = b""
    finally:
        os.close(fd)
        done, _ = os.waitpid(pid, os.WNOHANG)
        if done == 0:
            os.kill(pid, signal.SIGTERM)
            os.waitpid(pid, 0)
    if master_alive(config)[0]:
        return connection_fact("connected", None, "登录连接已建立。")
    stage = "动态码" if sent_code else "密码" if sent_password else "连接"
    return connection_fact("action_required", "auth_failed" if rejected else "connection_failed",
                           stage + "阶段未完成；自动恢复已停止。")


def remote_script(config: dict) -> str:
    public = {key: config[key] for key in ("ssh_host", "ssh_port", "partition", "qos", "account", "gpu_name", "vram_mib",
              "gpus_per_node", "cpus_per_gpu", "mem_gib_per_gpu", "workspace_path", "entry_verified")}
    return "CONFIG = " + repr(public) + "\nNODE_PROBE = " + repr(NODE_PROBE) + "\n" + REMOTE_HELPER


def ssh_python(config: dict, verb: str, *args: str, timeout: int = 40) -> str:
    # Only sealed verbs and bounded identifiers/numbers reach OpenSSH's remote command.
    result = subprocess.run(ssh_argv(config, "-o", "ControlMaster=no", "-o", "BatchMode=yes", config["ssh_host"],
                                    "python3", "-", verb, *args),
                            input=remote_script(config), capture_output=True, text=True, timeout=timeout)
    if result.returncode:
        raise RemoteFailure("provider " + verb + " failed; original allocation remains traceable",
                            no_capacity=result.returncode == NO_CAPACITY_EXIT_CODE)
    return result.stdout


def cmd_info() -> int:
    # Unconfigured reference plugins remain discoverable; they cannot allocate.
    try:
        maximum = load_config()["max_lease_seconds"]
        description = "Slurm 立即申请；连接管理与只读采集分离。"
    except (OSError, ValueError):
        maximum = 2592000
        description = "尚未配置；请在插件旁创建同名 JSON 配置，配置完成前不能连接或申请。"
    return emit({"plugin_id": Path(sys.argv[0]).name, "display_name": "Slurm 资源提供方",
                 "schema_version": PLUGIN_INFO_SCHEMA_VERSION,
                 "capabilities": ["observe", "apply", "release", "connect", "disconnect"],
                 "release_granularity": "allocation", "entry_kind": "allocation", "description": description,
                 "limits": {"lease_ends": "hard_kill_at_time_limit", "max_lease_seconds": maximum,
                            "apply_max_seconds": APPLY_MAX_SECONDS, "queues": False}})


def cmd_observe(config: dict) -> int:
    if not master_alive(config)[0]:
        return emit({"connection": connection_fact("disconnected", "session_missing", "登录连接已失效；需要恢复连接。")})
    payload = json.loads(ssh_python(config, "observe"))
    return emit({"schema_version": SCHEMA_VERSION, "nodes": payload["nodes"],
                 "scheduler": payload["scheduler"], "allocations": payload["allocations"]})


def cmd_apply(config: dict, argv: list[str]) -> int:
    if len(argv) != 11 or argv[1::2] != ["--gpu-count", "--task-ref", "--duration-seconds", "--request-id", "--requirements-json"]:
        return fail("apply requires count, task, duration, request identity and requirements", 2)
    count, task, duration, request_id, requirements_json = argv[2::2]
    requirements = json.loads(requirements_json)
    if not isinstance(requirements, dict):
        return fail("requirements must be an object", 2)
    if requirements.get("nodes", 1) != 1 or any(requirements.get(key) for key in ("gpu_ids", "deny_gpu_ids", "gpu_labels")):
        return fail("this provider supports single-node allocations without device pinning", 2)
    if not count.isdigit() or not 1 <= int(count) <= config["gpus_per_node"]:
        return fail("unsupported GPU count", 2)
    if not duration.isdigit() or not 60 <= int(duration) <= config["max_lease_seconds"]:
        return fail("unsupported task duration", 2)
    if not task.strip() or len(task) > 255 or not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", request_id):
        return fail("invalid task or request identity", 2)
    if requirements.get("gpus_per_node") not in {None, int(count)}:
        return fail("inconsistent GPUs per node", 2)
    supplies = {
        "cpu_cores": config["cpus_per_gpu"] * int(count),
        "min_available_cpu_cores": config["cpus_per_gpu"] * int(count),
        "memory_mib": config["mem_gib_per_gpu"] * int(count) * 1024,
        "min_available_memory_mib": config["mem_gib_per_gpu"] * int(count) * 1024,
        "min_total_vram_mib": config["vram_mib"],
    }
    if any((requirements.get(key) or 0) > available for key, available in supplies.items()):
        return fail("requirements exceed this provider's configured per-GPU resources", 2)
    if requirements.get("min_free_vram_mib"):
        return fail("free VRAM cannot be guaranteed before allocation; request total VRAM instead", 2)
    if not master_alive(config)[0]:
        return fail("login session missing; allocation was not submitted")
    try:
        payload = json.loads(ssh_python(config, "apply", count, duration, request_id, timeout=SSH_APPLY_TIMEOUT_SECONDS))
    except RemoteFailure as exc:
        return fail(str(exc), NO_CAPACITY_EXIT_CODE if exc.no_capacity else 1)
    return emit(payload)


def cmd_release(config: dict, argv: list[str]) -> int:
    if len(argv) != 3 or argv[1] != "--allocation-ref" or not ALLOCATION_REF_PATTERN.fullmatch(argv[2]):
        return fail("release requires a numeric allocation-ref")
    if not master_alive(config)[0]:
        return fail("login session missing; release remains unconfirmed")
    return emit(json.loads(ssh_python(config, "release", argv[2])))


def main(argv=None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv == ["info"]:
        return cmd_info()
    if not argv or argv[0] not in {"observe", "apply", "release", "connect", "disconnect"}:
        return fail("unsupported provider verb")
    try:
        config = load_config()
        if argv == ["connect"]:
            return emit(authenticate(config))
        if argv == ["disconnect"]:
            if master_alive(config)[0]:
                subprocess.run(ssh_argv(config, "-O", "exit", config["ssh_host"]), capture_output=True, timeout=5)
            if master_alive(config)[0]:
                return emit(connection_fact("action_required", "connection_failed", "断开连接尚未确认。"))
            return emit(connection_fact("disconnected", None, "连接维持已关闭；已有资源分配不受此操作管理。"))
        if argv == ["observe"]:
            return cmd_observe(config)
        if argv[0] == "apply":
            return cmd_apply(config, argv)
        if argv[0] == "release":
            return cmd_release(config, argv)
        return fail("invalid provider arguments")
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
        if argv[0] in {"connect", "disconnect"}:
            return emit(connection_fact("action_required", "connection_failed", "连接配置或操作失败；自动恢复已停止。"))
        return fail("provider operation failed; check configuration and connection status")


