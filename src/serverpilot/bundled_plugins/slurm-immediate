def parse_idx(spec):
    used = set()
    spec = spec.strip()
    if not spec:
        return used
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            start_s, end_s = part.split("-", 1)
            used.update(range(int(start_s), int(end_s) + 1))
        else:
            used.add(int(part))
    return used


def is_unschedulable(state):
    tokens = state.lower().replace("*", " ").replace("+", " ").split()
    if set(tokens) & UNSCHEDULABLE_TOKENS:
        return True
    return any(
        token.startswith("drain") or token.startswith("down") or token.startswith("fail")
        for token in tokens
    )


def parse_gres_total(text):
    match = re.search(r"gpu:[^:\s]+:(\d+)", text)
    if match is None:
        return GPUS_PER_NODE
    return int(match.group(1))


def parse_gres_used_indexes(text, total):
    text = text.strip()
    if not text or text in {"(null)", "N/A", "n/a"}:
        return set()
    idx_at = text.find("IDX:")
    if idx_at >= 0:
        inner = text[idx_at + 4:]
        if inner.endswith(")"):
            inner = inner[:-1]
        return {index for index in parse_idx(inner) if 0 <= index < total}
    match = re.search(r"gpu:[^:\s]+:(\d+)", text)
    count = int(match.group(1)) if match is not None else 0
    if count <= 0:
        return set()
    if count >= total:
        return set(range(total))
    return set(range(count))


def host_telemetry():
    cpu_count = os.cpu_count() or 1
    load_1m = 0.0
    try:
        with open("/proc/loadavg", encoding="utf-8") as handle:
            load_1m = float(handle.read().split()[0])
    except OSError:
        pass
    cpu_total_ticks = 0
    cpu_idle_ticks = 0
    try:
        with open("/proc/stat", encoding="utf-8") as handle:
            parts = handle.readline().split()
        if parts and parts[0] == "cpu":
            values = [int(item) for item in parts[1:]]
            cpu_total_ticks = sum(values)
            cpu_idle_ticks = values[3] + values[4] if len(values) > 4 else values[3]
    except OSError:
        pass
    memory_total_mib = 1
    memory_available_mib = 0
    try:
        mem = {}
        with open("/proc/meminfo", encoding="utf-8") as handle:
            for line in handle:
                key, _, value = line.partition(":")
                mem[key] = value.strip().split()[0]
        memory_total_mib = max(1, int(mem.get("MemTotal", "1024")) // 1024)
        memory_available_mib = int(mem.get("MemAvailable", "0")) // 1024
    except OSError:
        pass
    hostname = os.uname().nodename
    boot_id = "unknown"
    try:
        boot_id = open("/proc/sys/kernel/random/boot_id", encoding="utf-8").read().strip()
    except OSError:
        pass
    return {
        "hostname": hostname,
        "boot_id": boot_id,
        "cpu_count": cpu_count,
        "load_1m": load_1m,
        "cpu_total_ticks": cpu_total_ticks,
        "cpu_idle_ticks": cpu_idle_ticks,
        "memory_total_mib": memory_total_mib,
        "memory_available_mib": memory_available_mib,
    }


def cluster_free_gpu_count():
    try:
        raw = subprocess.check_output(
            [
                "sinfo",
                "-N",
                "-h",
                "-p",
                PARTITION,
                "-O",
                "NodeList:32,StateCompact:20,Gres:40,GresUsed:80",
            ],
            text=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return 0
    free = 0
    for line in raw.splitlines():
        if len(line) < 52:
            continue
        node = line[0:32].strip()
        state = line[32:52].strip()
        gres = line[52:92].strip()
        gres_used = line[92:].strip()
        if not node or is_unschedulable(state):
            continue
        total = parse_gres_total(gres)
        used = parse_gres_used_indexes(gres_used, total)
        free += max(0, total - len(used))
    return free


def running_jobs():
    try:
        raw = subprocess.check_output(
            ["squeue", "-u", os.environ.get("USER") or os.environ.get("LOGNAME") or "", "-h", "-t", "R", "-o", "%i|%T|%N"],
            text=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return []
    jobs = []
    for line in raw.splitlines():
        parts = line.strip().split("|")
        if len(parts) < 3:
            continue
        job_id, state, node = parts[0], parts[1], parts[2]
        if state != "RUNNING" or not job_id.isdigit():
            continue
        jobs.append({"job_id": job_id, "node": node})
    return jobs


def job_gpu_slots(job_id):
    try:
        raw = subprocess.check_output(["scontrol", "show", "job", job_id, "-d"], text=True)
    except (OSError, subprocess.CalledProcessError):
        return [], None
    node = None
    slots = []
    for line in raw.splitlines():
        text = line.strip()
        if text.startswith("Nodes=") or " Nodes=" in (" " + text):
            match = re.search(r"Nodes=(\S+)", text)
            if match:
                node = match.group(1).split(",")[0]
        match = re.search(r"GRES_IDX=gpu(?::[^\s(]+)?\(IDX:([^)]+)\)", text)
        if match:
            slots = sorted(parse_idx(match.group(1)))
    return slots, node


def read_sidecar(job_id):
    path = Path.home() / ".serverpilot" / ("alloc-%s.json" % job_id)
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(payload, dict):
        return None
    return payload


def cmd_observe():
    host = host_telemetry()
    gpus = []
    processes = []
    ordinal = 0
    username = os.environ.get("USER") or os.environ.get("LOGNAME") or "user"
    for job in running_jobs():
        sidecar = read_sidecar(job["job_id"])
        if sidecar and isinstance(sidecar.get("gpus"), list) and sidecar["gpus"]:
            for position, sample in enumerate(sidecar["gpus"]):
                if not isinstance(sample, dict):
                    continue
                uuid = sample.get("gpu_uuid")
                if not isinstance(uuid, str) or not uuid:
                    continue
                total = sample.get("total_vram_mib") or VRAM_MIB
                used = sample.get("memory_used_mib") or 0
                free = sample.get("memory_free_mib")
                if not isinstance(total, int) or total < 1:
                    total = VRAM_MIB
                if not isinstance(used, int) or used < 0:
                    used = 0
                if not isinstance(free, int) or free < 0:
                    free = max(0, total - used)
                gpu = {
                    "gpu_index": ordinal,
                    "cuda_ordinal": ordinal,
                    "gpu_uuid": uuid,
                    "name": sample.get("name") or GPU_NAME,
                    "total_vram_mib": total,
                    "memory_used_mib": min(used, total),
                    "memory_free_mib": min(free, total),
                    "gpu_utilization_pct": sample.get("gpu_utilization_pct"),
                    "memory_utilization_pct": sample.get("memory_utilization_pct"),
                    "temperature_c": sample.get("temperature_c"),
                    "power_watts": sample.get("power_watts"),
                    "pstate": sample.get("pstate"),
                    "health": "OK",
                }
                gpus.append(gpu)
                for process in sidecar.get("processes") or []:
                    if not isinstance(process, dict) or process.get("gpu_uuid") != uuid:
                        continue
                    pid = process.get("pid")
                    used_memory = process.get("used_memory_mib")
                    executable = process.get("executable") or "python"
                    if type(pid) is not int or pid < 1 or type(used_memory) is not int:
                        continue
                    processes.append({
                        "gpu_uuid": uuid,
                        "pid": pid,
                        "used_memory_mib": min(used_memory, total),
                        "executable": str(executable)[:255],
                        "username": process.get("username") or username,
                        "process_started_at": process.get("process_started_at") or "2020-01-01T00:00:00+00:00",
                    })
                ordinal += 1
            continue
        slots, node = job_gpu_slots(job["job_id"])
        node = node or job["node"]
        if not slots:
            slots = [0]
        for slot in slots:
            uuid = "gpu-%s-%s" % (node, slot)
            gpus.append({
                "gpu_index": ordinal,
                "cuda_ordinal": ordinal,
                "gpu_uuid": uuid,
                "name": GPU_NAME,
                "total_vram_mib": VRAM_MIB,
                "memory_used_mib": 0,
                "memory_free_mib": VRAM_MIB,
                "gpu_utilization_pct": 0,
                "memory_utilization_pct": 0,
                "temperature_c": None,
                "power_watts": None,
                "pstate": None,
                "health": "OK",
            })
            processes.append({
                "gpu_uuid": uuid,
                "pid": max(1, int(job["job_id"]) % 2_000_000_000),
                "used_memory_mib": 1,
                "executable": "slurm-job",
                "username": username,
                "process_started_at": "2020-01-01T00:00:00+00:00",
            })
            ordinal += 1
    print(json.dumps({
        "hostname": host["hostname"],
        "boot_id": host["boot_id"],
        "cpu_count": host["cpu_count"],
        "load_1m": host["load_1m"],
        "cpu_total_ticks": host["cpu_total_ticks"],
        "cpu_idle_ticks": host["cpu_idle_ticks"],
        "memory_total_mib": host["memory_total_mib"],
        "memory_available_mib": host["memory_available_mib"],
        "gpus": gpus,
        "processes": processes,
        "scheduler": {
            "free_gpu_count": cluster_free_gpu_count(),
            "gpu_name": GPU_NAME,
            "note": "按需申请，不排队",
        },
    }, separators=(",", ":")))


def workspace_path():
    configured = CONFIG.get("workspace_path") or ""
    if configured.startswith("/"):
        return configured
    return str(Path.home())


def parse_smi_gpus(lines):
    gpus = []
    for line in lines:
        parts = [item.strip() for item in line.split(",")]
        if len(parts) < 4:
            continue
        uuid = parts[1]
        if not uuid.startswith("GPU-"):
            continue
        try:
            total = max(1, int(float(parts[3])))
        except ValueError:
            total = VRAM_MIB
        gpus.append({
            "gpu_uuid": uuid,
            "name": parts[2] if len(parts) > 2 else GPU_NAME,
            "total_vram_mib": total,
        })
    return gpus


def cmd_apply():
    gpu_count = int(sys.argv[2])
    job_name = sys.argv[3]
    cache = Path.home() / ".serverpilot"
    cache.mkdir(mode=0o700, exist_ok=True)
    hold = cache / "slurm-immediate-hold.py"
    hold.write_text(HOLD_SCRIPT, encoding="utf-8")
    log = Path(tempfile.mkstemp(prefix="splog", suffix=".txt")[1])
    log_handle = open(log, "w", encoding="utf-8")
    argv = [
        "srun",
        f"-I{APPLY_IMMEDIATE_SECONDS}",
        f"--time={APPLY_TIME_LIMIT}",
        "-p", PARTITION,
    ]
    if QOS:
        argv.append(f"--qos={QOS}")
    if ACCOUNT:
        argv.extend(["-A", ACCOUNT])
    argv.extend([
        "-N1",
        f"--gres=gpu:{gpu_count}",
        "-c", str(CPUS_PER_GPU * gpu_count),
        f"--mem={MEM_GIB_PER_GPU * gpu_count}G",
        "--job-name", job_name,
        "python3", str(hold),
    ])
    try:
        proc = subprocess.Popen(
            argv,
            stdout=log_handle,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    except OSError as exc:
        log_handle.close()
        raise SystemExit(f"srun could not start: {exc}") from exc
    deadline = time.time() + APPLY_IMMEDIATE_SECONDS + 8
    allocated = None
    smi_lines = []
    while time.time() < deadline:
        text = log.read_text(encoding="utf-8", errors="replace")
        if "Unable to allocate resources" in text or "Immediate termination" in text:
            proc.poll()
            sys.stderr.write((text.strip().splitlines()[-1][:500] if text.strip() else "srun found nothing free") + "\n")
            raise SystemExit(NO_CAPACITY_EXIT_CODE)
        for line in text.splitlines():
            if line.startswith("ALLOC\t"):
                parts = line.split("\t")
                if len(parts) >= 4:
                    allocated = {"job_id": parts[1], "node": parts[2], "cuda": parts[3]}
            elif allocated is not None and "," in line:
                smi_lines.append(line.strip())
        if allocated is not None and (smi_lines or proc.poll() is not None):
            break
        if proc.poll() is not None and allocated is None:
            raise SystemExit(text.strip().splitlines()[-1][:500] if text.strip() else "srun exited before allocation")
        time.sleep(0.4)
    if allocated is None:
        proc.terminate()
        subprocess.run(["scancel", "--jobname", job_name], capture_output=True, check=False)
        sys.stderr.write("no immediate GPU capacity on partition %s\n" % PARTITION)
        raise SystemExit(NO_CAPACITY_EXIT_CODE)
    cuda = allocated["cuda"]
    if not re.fullmatch(r"[0-9]+(,[0-9]+)*", cuda):
        subprocess.run(["scancel", allocated["job_id"]], capture_output=True, check=False)
        raise SystemExit("srun CUDA_VISIBLE_DEVICES is invalid")
    user = os.environ.get("USER") or os.environ.get("LOGNAME") or Path.home().name
    print(json.dumps({
        "allocation_ref": allocated["job_id"],
        "ssh": {"host": CONFIG["ssh_host"], "port": int(CONFIG["ssh_port"]), "user": user},
        "workspace_path": workspace_path(),
        "cuda_visible_devices": cuda,
        "gpus": parse_smi_gpus(smi_lines),
        "node": allocated["node"],
    }, separators=(",", ":")))


def cmd_release():
    job_id = sys.argv[2]
    sidecar = Path.home() / ".serverpilot" / ("alloc-%s.json" % job_id)
    completed = subprocess.run(["scancel", job_id], capture_output=True, text=True, check=False)
    sidecar.unlink(missing_ok=True)
    detail = (completed.stderr or completed.stdout).strip()
    if completed.returncode == 0 or not detail or "Invalid job id" in detail or "already" in detail.lower():
        print(json.dumps({"state": "released"}, separators=(",", ":")))
        return
    raise SystemExit(detail[:500])


